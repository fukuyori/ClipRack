<Window x:Class="Clippy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.Title}" Height="780" Width="1120"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        MinHeight="640" MinWidth="900" WindowStartupLocation="CenterScreen"
        StateChanged="MainWindow_StateChanged" Closing="MainWindow_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ClipRack" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Text.Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="{DynamicResource Text.History}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="{DynamicResource Text.RefreshHistory}" Click="RefreshHistory_Click" Padding="12,6" />
                        <TextBlock x:Name="HistoryStatus" Margin="12,6,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ListBox x:Name="HistoryList" Grid.Row="1" SelectionChanged="HistoryList_SelectionChanged"
                             DisplayMemberPath="DisplayText">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="HistoryItem_PreviewMouseRightButtonDown" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Text.TextEditing}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="{DynamicResource Text.LoadSelectedHistory}" Click="LoadSelectedHistory_Click" Padding="10,6" Margin="0,0,6,0" />
                        <Button Content="{DynamicResource Text.PlainText}" Click="PlainText_Click" Padding="10,6" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Text.Newline}" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <ComboBox x:Name="NewlineMode" Width="90" SelectedIndex="0" Margin="0,0,6,0">
                            <ComboBoxItem Content="CRLF" />
                            <ComboBoxItem Content="LF" />
                            <ComboBoxItem Content="CR" />
                        </ComboBox>
                        <Button Content="{DynamicResource Text.ConvertNewline}" Click="Newline_Click" Padding="10,6" Margin="0,0,6,0" />
                        <Button Content="{DynamicResource Text.CollapseBlankLines}" Click="CollapseBlankLines_Click" Padding="10,6" />
                    </WrapPanel>
                    <TextBox x:Name="TextEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="14" />
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Text.Find}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="FindText" Width="190" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Text.ReplaceWith}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="ReplacementText" Width="190" Margin="0,0,8,0" />
                        <CheckBox x:Name="RegexMode" Content="{DynamicResource Text.Regex}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox x:Name="IgnoreCase" Content="{DynamicResource Text.IgnoreCase}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox x:Name="RegexMultiline" Content="{DynamicResource Text.Multiline}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Text.Replace}" Click="Replace_Click" Padding="12,6" />
                    </WrapPanel>
                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Text.CopyResult}" Click="CopyResult_Click" Padding="12,7" />
                        <TextBlock x:Name="EditStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Text.Macros}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Column="0" LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="{DynamicResource Text.New}" Click="NewMacro_Click" Padding="9,5" Margin="0,0,4,0" />
                            <Button Content="{DynamicResource Text.Delete}" Click="DeleteMacro_Click" Padding="9,5" />
                        </WrapPanel>
                        <ListBox x:Name="MacroList" SelectionChanged="MacroList_SelectionChanged" />
                    </DockPanel>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Text.Save}" Click="SaveMacro_Click" Padding="12,6" />
                            <TextBox x:Name="MacroName" VerticalContentAlignment="Center" TextChanged="MacroName_TextChanged" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Text.MacroHelp}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Text.Find}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="MacroFindText" Width="150" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Text.ReplaceWith}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="MacroReplacementText" Width="150" Margin="0,0,8,0" />
                            <CheckBox x:Name="MacroRegexMode" Content="{DynamicResource Text.Regex}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox x:Name="MacroIgnoreCase" Content="{DynamicResource Text.IgnoreCaseShort}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox x:Name="MacroRegexMultiline" Content="{DynamicResource Text.Multiline}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Text.Newline}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="MacroNewlineMode" Width="72" SelectedIndex="0">
                                <ComboBoxItem Content="CRLF" />
                                <ComboBoxItem Content="LF" />
                                <ComboBoxItem Content="CR" />
                            </ComboBox>
                        </WrapPanel>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="MacroSteps" DisplayMemberPath="." SelectionChanged="MacroSteps_SelectionChanged" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button Content="{DynamicResource Text.AddPlain}" Click="AddPlainStep_Click" Margin="0,0,0,4" Padding="8,5" />
                                <Button Content="{DynamicResource Text.AddNewline}" Click="AddNewlineStep_Click" Margin="0,0,0,4" Padding="8,5" />
                                <Button Content="{DynamicResource Text.AddBlank}" Click="AddBlankStep_Click" Margin="0,0,0,4" Padding="8,5" />
                                <Button Content="{DynamicResource Text.AddReplace}" Click="AddReplaceStep_Click" Margin="0,0,0,12" Padding="8,5" />
                                <Button Content="{DynamicResource Text.MoveUp}" Click="MoveStepUp_Click" Margin="0,0,0,4" Padding="8,5" />
                                <Button Content="{DynamicResource Text.MoveDown}" Click="MoveStepDown_Click" Margin="0,0,0,4" Padding="8,5" />
                                <Button Content="{DynamicResource Text.UpdateStep}" Click="UpdateStep_Click" Margin="0,0,0,4" Padding="8,5" />
                                <Button Content="{DynamicResource Text.RemoveStep}" Click="RemoveStep_Click" Padding="8,5" />
                            </StackPanel>
                        </Grid>
                        <DockPanel Grid.Row="4" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Text.RunMacro}" Click="RunMacro_Click" Padding="12,7" />
                            <TextBlock x:Name="MacroStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{DynamicResource Text.MacroTabHelp}" />
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Text.Translation}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Text.OllamaTranslation}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox x:Name="TranslationSource" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <WrapPanel Grid.Row="2" Margin="0,8">
                        <Button Content="{DynamicResource Text.LoadFromHistory}" Click="LoadSelectedTranslation_Click" Padding="12,7" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Text.Translate}" Click="Translate_Click" Padding="14,7" />
                    </WrapPanel>
                    <TextBox x:Name="TranslationResult" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Text.UseTranslation}" Click="UseTranslation_Click" Padding="12,7" />
                        <TextBlock x:Name="TranslationStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Text.Settings}">
                <Grid Margin="20" MaxWidth="760" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource Text.AppSettings}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Grid.Row="1" Text="{DynamicResource Text.Theme}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeSetting" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="{DynamicResource Text.SystemDefault}" Tag="System" />
                        <ComboBoxItem Content="{DynamicResource Text.Light}" Tag="Light" />
                        <ComboBoxItem Content="{DynamicResource Text.Dark}" Tag="Dark" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="{DynamicResource Text.Language}" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageSetting" Grid.Row="2" Grid.Column="1" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="{DynamicResource Text.SystemDefault}" Tag="System" />
                        <ComboBoxItem Content="{DynamicResource Text.English}" Tag="English" />
                        <ComboBoxItem Content="{DynamicResource Text.Japanese}" Tag="Japanese" />
                    </ComboBox>
                    <CheckBox x:Name="AutoStartSetting" Grid.Row="3" Grid.ColumnSpan="2" Content="{DynamicResource Text.AutoStart}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="4" Text="{DynamicResource Text.Hotkey}" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Text.Clear}" Click="ClearHotkey_Click" Padding="10,4" Margin="8,0,0,0" />
                        <TextBox x:Name="HotkeySetting" IsReadOnly="True" PreviewKeyDown="HotkeySetting_PreviewKeyDown" ToolTip="{DynamicResource Text.HotkeyTip}" />
                    </DockPanel>
                    <TextBlock Grid.Row="5" Text="{DynamicResource Text.WindowPosition}" VerticalAlignment="Center" />
                    <ComboBox x:Name="DisplayPositionSetting" Grid.Row="5" Grid.Column="1" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="{DynamicResource Text.NearCaret}" Tag="Caret" />
                        <ComboBoxItem Content="{DynamicResource Text.NearMouse}" Tag="Mouse" />
                    </ComboBox>
                    <TextBlock Grid.Row="6" Text="{DynamicResource Text.OllamaEndpoint}" VerticalAlignment="Center" />
                    <TextBox x:Name="EndpointSetting" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="7" Text="{DynamicResource Text.Model}" VerticalAlignment="Center" />
                    <TextBox x:Name="ModelSetting" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="8" Text="{DynamicResource Text.SourceLanguage}" VerticalAlignment="Center" />
                    <TextBox x:Name="SourceLanguageSetting" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="9" Text="{DynamicResource Text.TargetLanguage}" VerticalAlignment="Center" />
                    <TextBox x:Name="TargetLanguageSetting" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" />
                    <Button Grid.Row="10" Grid.Column="1" Content="{DynamicResource Text.SaveSettings}" Click="SaveSettings_Click" HorizontalAlignment="Left" Padding="14,7" />
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="FooterStatus" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
    </Grid>
</Window>
